import os

builder.SetBuildFolder('package')
sourcemod = os.path.join('addons', 'sourcemod')
extension_dir = builder.AddFolder(os.path.join(sourcemod, 'extensions'))
extension_x64_dir = builder.AddFolder(os.path.join(sourcemod, 'extensions', 'x64'))
include_dir = builder.AddFolder(os.path.join(sourcemod, 'scripting', 'include'))

for extension in extensions:
    folder = extension_x64_dir if extension.target.arch == 'x86_64' else extension_dir
    builder.AddCopy(extension.binary, folder)

builder.AddCopy(os.path.join(builder.sourcePath, 'scripting', 'botcontroller.inc'), include_dir)
